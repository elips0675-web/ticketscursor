generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "mysql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
}

model employees {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  password_hash  String    @db.VarChar(255)
  role           String?   @default("agent") @db.VarChar(20)
  department     String?   @default("") @db.VarChar(255)
  avatar         String?   @default("") @db.VarChar(500)
  phone          String?   @default("") @db.VarChar(50)
  online         Boolean?  @default(false)
  active_tickets Int?      @default(0)
  resolved_today Int?      @default(0)
  title          String?   @default("") @db.VarChar(100)
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now())
  last_active    DateTime?

  tickets_created_by  tickets[]          @relation("tickets_created_by")
  tickets_assigned_to tickets[]          @relation("tickets_assigned_to")
  tickets_locked_by   tickets[]          @relation("tickets_locked_by")
  recurrences_assigned ticket_recurrences[] @relation("RecurrenceAssignedTo")
  recurrences_created  ticket_recurrences[] @relation("RecurrenceCreatedBy")
  rules_created        automation_rules[]   @relation("RuleCreatedBy")
  events              events[]
  polls               polls[]
  file_folders        file_folders[]
  files               files[]
  chat_messages       chat_messages[]
  wiki_articles       wiki_articles[]
  news_posts          news_posts[]
  push_subscriptions  push_subscriptions?
  refresh_tokens      refresh_tokens[]
  notifications       notifications[]
  poll_votes          poll_votes[]
  ticket_messages     ticket_messages[]
  time_entries        time_entries[]
  ticket_timers       ticket_timers[]
  api_tokens          api_tokens[]
  webhooks_created    webhooks[]           @relation("WebhookCreatedBy")
}

model tickets {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(500)
  description String?  @db.Text
  status      String?  @default("open") @db.VarChar(20)
  priority    String?  @default("medium") @db.VarChar(20)
  category    String?  @default("support") @db.VarChar(50)
  created_by Int
  assigned_to Int?
  due_at      DateTime?
  first_response_at DateTime?
  resolved_at DateTime?
  escalated_at DateTime?
  escalation_level Int       @default(0)
  sla_paused_at   DateTime?
  sla_accumulated_ms Int     @default(0)
  tags        Json?
  locked_by   Int?
  locked_at   DateTime?
  created_at  DateTime? @default(now())
  updated_at  DateTime? @default(now())
  deleted_at  DateTime?

  created_by_employee  employees?      @relation("tickets_created_by", fields: [created_by], references: [id])
  assigned_to_employee employees?      @relation("tickets_assigned_to", fields: [assigned_to], references: [id])
  locked_by_employee   employees?      @relation("tickets_locked_by", fields: [locked_by], references: [id], onDelete: SetNull)
  ticket_messages      ticket_messages[]
  time_entries         time_entries[]
  ticket_timers        ticket_timers[]
  csat_surveys         csat_surveys[]
  custom_field_values  custom_field_values[]

  @@index([locked_by])
}

model custom_field_definitions {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  type        String    @db.VarChar(20)
  options     Json?
  required    Boolean?  @default(false)
  category    String?   @default("general") @db.VarChar(50)
  sort_order  Int?      @default(0)
  enabled     Boolean?  @default(true)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @default(now())

  values custom_field_values[]
}

model custom_field_values {
  id              Int       @id @default(autoincrement())
  field_id        Int
  ticket_id       Int
  value           String?   @db.Text
  created_at      DateTime? @default(now())
  updated_at      DateTime? @default(now())

  field  custom_field_definitions? @relation(fields: [field_id], references: [id], onDelete: Cascade)
  ticket tickets?                  @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@unique([field_id, ticket_id])
  @@index([ticket_id])
}

model time_entries {
  id          Int       @id @default(autoincrement())
  ticket_id   Int
  user_id     Int
  minutes     Int
  description String?   @default("") @db.VarChar(500)
  entry_date  DateTime  @db.Date
  created_at  DateTime? @default(now())

  ticket tickets?   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([ticket_id, user_id])
}

model ticket_timers {
  id         Int       @id @default(autoincrement())
  ticket_id  Int
  user_id    Int
  started_at DateTime
  created_at DateTime? @default(now())

  ticket tickets?   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([ticket_id, user_id])
}

model ticket_messages {
  id            Int       @id @default(autoincrement())
  ticket_id     Int
  sender_id     Int
  sender_name   String    @db.VarChar(255)
  sender_avatar String?   @default("") @db.VarChar(500)
  text          String    @db.Text
  attachments   Json?
  mentions      Json?
  is_internal   Boolean?  @default(false)
  created_at    DateTime? @default(now())
  deleted_at    DateTime?

  ticket   tickets?   @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  employee employees? @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model events {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(200)
  date        DateTime  @db.Date
  time        String?   @db.VarChar(10)
  description String?   @db.Text
  creator_id  Int?
  created_at  DateTime? @default(now())

  creator employees? @relation(fields: [creator_id], references: [id], onDelete: SetNull)
}

model polls {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  multiple_choice Boolean?  @default(false)
  ends_at         DateTime?
  show_results    String?   @default("after_vote") @db.VarChar(20)
  created_by      Int?
  created_at      DateTime? @default(now())

  creator      employees?    @relation(fields: [created_by], references: [id], onDelete: SetNull)
  poll_options poll_options[]
  poll_votes   poll_votes[]
}

model poll_options {
  id          Int      @id @default(autoincrement())
  poll_id     Int
  text        String   @db.VarChar(200)
  votes_count Int?     @default(0)

  poll       polls?       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  poll_votes poll_votes[]
}

model poll_votes {
  id        Int      @id @default(autoincrement())
  poll_id   Int
  option_id Int
  user_id   Int
  created_at DateTime? @default(now())

  poll   polls?       @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  option poll_options? @relation(fields: [option_id], references: [id], onDelete: Cascade)
  user   employees?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([poll_id, option_id, user_id])
}

model file_folders {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100)
  user_id    Int
  is_shared  Boolean?  @default(false)
  created_at DateTime? @default(now())

  user  employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)
  files files[]
}

model files {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(200)
  size      String?   @db.VarChar(20)
  type      String?   @db.VarChar(50)
  folder_id Int?
  path      String?   @db.VarChar(500)
  user_id   Int
  created_at DateTime? @default(now())
  deleted_at DateTime?

  folder file_folders? @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  user   employees?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model chat_rooms {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(200)
  type       String?   @default("group") @db.VarChar(20)
  unread     Int?      @default(0)
  created_at DateTime? @default(now())

  chat_messages chat_messages[]
}

model chat_messages {
  id          Int       @id @default(autoincrement())
  chat_id     Int
  sender_id   Int
  sender_name String    @db.VarChar(255)
  text        String    @db.Text
  created_at  DateTime? @default(now())
  deleted_at  DateTime?

  chat   chat_rooms? @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  sender employees?  @relation(fields: [sender_id], references: [id], onDelete: Cascade)
}

model chat_read_receipts {
  id                   Int        @id @default(autoincrement())
  chat_id              Int
  user_id              Int
  last_read_message_id Int?
  last_read_at         DateTime?  @default(now())

  @@unique([chat_id, user_id])
}

model wiki_articles {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(300)
  content     String    @db.Text
  category    String?   @default("Другое") @db.VarChar(100)
  tags        Json?
  author_id   Int
  author_name String    @db.VarChar(255)
  created_at  DateTime? @default(now())
  updated_at  DateTime? @default(now())

  author employees? @relation(fields: [author_id], references: [id], onDelete: Cascade)
}

model news_posts {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(300)
  content     String    @db.Text
  important   Boolean?  @default(false)
  author_id   Int
  author_name String    @db.VarChar(255)
  created_at  DateTime? @default(now())

  author employees? @relation(fields: [author_id], references: [id], onDelete: Cascade)
}

model push_subscriptions {
  id                Int       @id @default(autoincrement())
  user_id           Int       @unique
  subscription_json String    @db.Text
  created_at        DateTime? @default(now())

  user employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @db.VarChar(500)
  created_at DateTime? @default(now())
  expires_at DateTime

  user employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  type       String?   @db.VarChar(50)
  title      String?   @db.VarChar(500)
  body       String?   @db.Text
  link       String?   @db.VarChar(500)
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now())

  user employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model admin_settings {
  id         Int       @id @default(autoincrement())
  key        String?   @unique @db.VarChar(100)
  value      String?   @db.Text
  updated_at DateTime? @default(now())
}

model audit_log {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  user_name   String?   @db.VarChar(255)
  action      String?   @db.VarChar(50)
  entity_type String?   @db.VarChar(50)
  entity_id   Int?
  details     String?   @db.Text
  created_at  DateTime? @default(now())
}

model password_resets {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(500)
  expires_at DateTime
  created_at DateTime? @default(now())
}

model feature_flags {
  key         String    @id @db.VarChar(100)
  enabled     Boolean   @default(true)
  description String?   @default("") @db.VarChar(500)
  updated_at  DateTime? @default(now())

  @@map("feature_flags")
}

model canned_responses {
  id         Int       @id @default(autoincrement())
  title      String    @db.VarChar(255)
  text       String    @db.Text
  category   String?   @default("") @db.VarChar(100)
  created_by Int
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())

  @@map("canned_responses")
}

model csat_surveys {
  id          Int       @id @default(autoincrement())
  ticket_id   Int
  token       String    @unique @db.VarChar(100)
  rating      Int?      @db.Int
  comment     String?   @db.Text
  requester_email String? @db.VarChar(255)
  sent_at     DateTime?
  responded_at DateTime?
  created_at  DateTime? @default(now())

  ticket tickets? @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([token])
  @@map("csat_surveys")
}

model ticket_recurrences {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(500)
  description    String?   @db.Text
  priority       String?   @default("medium") @db.VarChar(20)
  category       String?   @db.VarChar(50)
  assigned_to    Int?
  cron_expr      String    @db.VarChar(100)
  next_run       DateTime?
  is_active      Boolean?  @default(true)
  last_run       DateTime?
  created_by     Int?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())
  deleted_at     DateTime?

  assigned_employee employees? @relation("RecurrenceAssignedTo", fields: [assigned_to], references: [id], onDelete: SetNull)
  creator_employee  employees? @relation("RecurrenceCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([is_active, next_run])
  @@map("ticket_recurrences")
}

model event_outbox {
  id         Int       @id @default(autoincrement())
  event_type String    @db.VarChar(50)
  room       String?   @db.VarChar(100)
  payload    String    @db.Text
  created_at DateTime? @default(now())
  sent_at    DateTime?

  @@index([sent_at, created_at])
  @@map("event_outbox")
}

model api_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  name       String    @db.VarChar(255)
  token_hash String    @unique @db.VarChar(64)
  prefix     String    @db.VarChar(12)
  scopes     String?   @db.Text
  expires_at DateTime?
  last_used  DateTime?
  created_at DateTime? @default(now())
  deleted_at DateTime?

  employee employees? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
  @@map("api_tokens")
}

model webhooks {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  url        String    @db.VarChar(500)
  secret     String?   @db.VarChar(255)
  events     String    @db.Text
  is_active  Boolean   @default(true)
  last_status Int?     @db.Int
  last_error String?   @db.Text
  last_triggered_at DateTime?
  created_by Int?
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  deleted_at DateTime?

  creator_employee employees? @relation("WebhookCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([is_active])
  @@map("webhooks")
}

model automation_rules {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  trigger_event  String    @db.VarChar(50)
  conditions     Json
  actions        Json
  is_active      Boolean   @default(true)
  last_run       DateTime?
  run_count      Int       @default(0)
  created_by     Int?
  created_at     DateTime? @default(now())
  updated_at     DateTime? @default(now())
  deleted_at     DateTime?

  creator_employee employees? @relation("RuleCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([is_active, trigger_event])
  @@map("automation_rules")
}
